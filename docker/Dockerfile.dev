# =============================================================================
# Development Image - tabssh debug mode via cargo run
# =============================================================================
FROM casjaysdev/rust:latest

ARG BUILD_DATE
ARG VCS_REF

RUN apk add --no-cache \
    libx11 \
    libxcb \
    wayland-libs-client \
    mesa-gl \
    ttf-dejavu

RUN adduser -D -h /home/dev dev \
    && mkdir -p /usr/local/cargo/registry /usr/local/cargo/git /work/target \
    && chown -R dev:dev /usr/local/cargo/registry /usr/local/cargo/git /work /home/dev

COPY docker/rootfs/ /

RUN chmod +x /usr/local/bin/entrypoint.sh

USER dev
WORKDIR /work

STOPSIGNAL SIGTERM

ENTRYPOINT ["tini", "-p", "SIGTERM", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["cargo", "run", "--", "--ui", "gui"]
